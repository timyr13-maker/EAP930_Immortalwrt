. /lib/functions.sh
#. /lib/functions/network.sh
. /lib/functions/hal_common.sh

#if is_bridge_config || is_bridge_runtime ; then
#	ip6tables -t nat -F ipv6masq
#	ip6tables -t nat -D POSTROUTING -j ipv6masq
#	exit
#fi

interface_get_device()
{
	local interface=$1
	local device

	config_get device "$interface" 'device'
	[ -z "$device" ] && echo "" 

	if [ "${device:0:1}" == "@" ]; then
		interface_get_device "${device:1}"
	else
		echo "$device"
	fi
}

set_masq()
{
	local interface=$1
	local auto=0
	local device

	config_get_bool auto "$interface" 'auto' 0
	[ $auto -gt 0 ] || return

#	network_get_device device "$interface"
	[ -z "$device" ] && device=$(interface_get_device "$interface")
	[ -z "$device" ] && {
		echo "wan interface ($interface) not found device"
		return
	}

	ip6tables -t nat -A ipv6masq -o $device -j MASQUERADE
}

ip6tables -t nat -N ipv6masq
ip6tables -t nat -F ipv6masq
ip6tables -t nat -D POSTROUTING -j ipv6masq
add=0

config_load network

for interface in $(uci get firewall.ipv6masq.interface 2&>/dev/null); do
	set_masq $interface
	add=1
done

[ $add -eq 1 ] && ip6tables -t nat -A POSTROUTING -j ipv6masq

