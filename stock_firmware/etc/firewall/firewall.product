
ebtables -N wan_forward -P RETURN && {
	ebtables -A FORWARD -j wan_forward
}

ebtables -N vlan_port_input -P RETURN && {
	ebtables -A INPUT -j vlan_port_input
}

ebtables -N vlan_port_forward -P RETURN && {
	ebtables -A FORWARD -j vlan_port_forward
}

ebtables -N vlan_port_output -P RETURN && {
	ebtables -A OUTPUT -j vlan_port_output
}

ebtables -N dev_blacklist -P RETURN && {
	ebtables -I FORWARD -j dev_blacklist
	ebtables -I INPUT -j dev_blacklist
	ebtables -I OUTPUT -j dev_blacklist
}
