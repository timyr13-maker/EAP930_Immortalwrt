LED_UP="led_event USB_UP"
LED_DOWN="led_event USB_DOWN"
COUNT_USB=$(mount | grep /mnt/usb | wc -l)
DEV_PATH="/devices/platform/11200000.xhci/usb"
result=$(echo $DEVPATH | grep "${DEV_PATH}")
if [ "$ACTION" = "add" -a "$result" != "" ];then
        ${LED_UP}
        touch /tmp/usb_led.txt
elif [ "$ACTION" = "remove" ];then
    if [ ${COUNT_USB} -eq 0 ];then
        ${LED_DOWN}
        rm -rf /tmp/usb_led.txt
    fi
fi