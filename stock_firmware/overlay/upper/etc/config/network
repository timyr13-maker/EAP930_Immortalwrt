
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config device 'dev_lan'
	option name 'br-lan'
	option type 'bridge'
	option igmp_snooping '1'
	option ageing_time '120'
	option macaddr '88:BD:09:88:C2:4B'
	option bindports '3'
	list ports 'eth1'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option ipv6 '0'
	option mode 'bridge'
	option ipaddr '192.168.0.1'

config interface 'wan1'
	option conn_name 'wan1_internet'
	option service_type 'internet'
	option proto 'dhcp'
	option auto '1'
	option metric '10'
	option device '@lan'

config interface 'wan1_ipv6'
	option device 'eth1'
	option proto 'none'
	option peerdns '1'
	option auto '0'
	option metric '10'

config device 'dev_wan1_raw'
	option name 'eth1'
	option macaddr '88:BD:09:88:C2:4B'
	option ipv6 '1'

