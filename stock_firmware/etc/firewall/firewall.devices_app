restart=0

ebtables -L internet_rule &> /dev/null && {
	restart=1
}

iptables -N IP_HASHLIMIT
iptables -I FORWARD -j IP_HASHLIMIT


iptables -N URL_FILTER
iptables -I FORWARD -j URL_FILTER

ip6tables -N URL_FILTER
ip6tables -I FORWARD -j URL_FILTER


iptables -N IP_FILTER
iptables -I FORWARD -j IP_FILTER


iptables -N storage_rule
iptables -I INPUT -j storage_rule

ip6tables -N storage_rule
ip6tables -I INPUT -j storage_rule


iptables -N internet_rule
iptables -I FORWARD -j internet_rule

ip6tables -N internet_rule
ip6tables -I FORWARD -j internet_rule

ebtables -N internet_rule -P RETURN && {
	ebtables -A FORWARD -j internet_rule
	ebtables -A internet_rule -p ipv4 --ip-proto udp --ip-dport 67 -j RETURN
}

ebtables -N MAC_SPEEDLIMIT_DOWN -P RETURN && {
	ebtables -A POSTROUTING -j MAC_SPEEDLIMIT_DOWN
}

ebtables -N MAC_SPEEDLIMIT_UP -P RETURN && {
	ebtables -A PREROUTING -j MAC_SPEEDLIMIT_UP
}

[ $restart -eq 1 ] && ubus call devices_app reload_firewall_rule

